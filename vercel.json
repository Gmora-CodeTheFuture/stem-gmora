{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "installCommand": "npm ci && composer install --no-dev --optimize-autoloader --no-interaction",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1",
            "headers": { "cache-control": "public, max-age=31536000, immutable" }
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt|logo[^/]*\\.(?:svg|png))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*\\.(?:css|js|map|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
