APP_NAME="Gmora STEM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Containers / Kubernetes: use stderr so logs go to the cluster log driver.
LOG_STACK=single
# LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Local default: sqlite. Production / Docker Compose / K8s: pgsql.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=gmora
# DB_USERNAME=gmora
# DB_PASSWORD=

# Remote-database tuning (e.g. Neon / managed Postgres).
DB_PERSISTENT=false
DB_EMULATE_PREPARES=false

# --- Session / cache / queue ---
# Single-node local: database is fine.
# Multi-replica (Docker Compose scale / Kubernetes): use redis for all three.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Behind TLS Ingress set SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Filesystems ---
# local = storage/app on the pod (not safe across replicas).
# FILESYSTEM_CLOUD=s3 routes local/private/public disks to S3-compatible storage.
FILESYSTEM_DISK=local
FILESYSTEM_CLOUD=local
# FILESYSTEM_CLOUD=s3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Production / Kubernetes reference (do not use as-is locally) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://learn.example.com
# LOG_CHANNEL=stack
# LOG_STACK=stderr
# DB_CONNECTION=pgsql
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# FILESYSTEM_CLOUD=s3
# SESSION_SECURE_COOKIE=true
